<div class="govuk-grid-row">
  <div class="govuk-grid-column-one-third">
    <%= erb :'api_tech_docs/component__navigation' %>
  </div>
  <div class="govuk-grid-column-two-thirds">
    <div class="govuk-!-margin-bottom-7">
      <h1 class="govuk-heading-l">Fetch list of fields which return codes</h1>

      <p>
        Many certificate fields contain codes rather than the full descriptive text. Fetch a list of fields for which we currently provide values.
      </p>
      <p>
        If this list does not contain the field you are looking for, you can find more information <a href="https://github.com/communitiesuk/epb-register-api/tree/main/api/schemas/xml">here</a> in the XSD files for the original data.
      </p>
    </div>

    <div class="govuk-!-margin-bottom-7">
      <h2 class="govuk-heading-m">Method</h2>

      <pre><code>GET /api/codes</code></pre>
    </div>

    <div class="govuk-!-margin-bottom-7">
      <h2 class="govuk-heading-m">Response</h2>

      <p>
        If the request is successful, the response body is json with a status code of 200:
      </p>
      <pre><code class="javascript"><%=  ViewModels::ApiTechDocs.codes_response %></code></pre>
    </div>

    <div class="govuk-!-margin-bottom-7">
      <h2 class="govuk-heading-m">Example</h2>

      <p>
        If the request is successful, the response body is json with a status code of 200:
      </p>
      <pre><code class="javascript"><%= ViewModels::ApiTechDocs.curl_example "/api/codes" %></code></pre>
    </div>


    <div class="govuk-!-margin-bottom-7">
      <h3 class="govuk-heading-m">Download in csv format  </h3>
        <a href="/download/codes" role="button" draggable="false" class="govuk-button" data-module="govuk-button" data-govuk-button-init>Download codes</a>
    </div>
  </div>
</div>
